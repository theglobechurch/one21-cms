{
  "name": "one21-cms",
  "private": true,
  "scripts": {
    "dev": "watch 'npm run dev:build' app/assets/*",
    "dev:build": "npm run dev:js && npm run dev:adminCSS && npm run dev:landingCSS",
    "dev:js": "webpack --mode development",
    "dev:adminCSS": "sass --embed-source-map app/assets/stylesheets/application.scss:public/assets/css/main.css",
    "dev:landingCSS": "sass --embed-source-map app/assets/stylesheets/landing.scss:public/assets/css/landing.css",
    "prod": "npm run prod:js && npm run prod:adminCSS && npm run prod:landingCSS",
    "prod:js": "webpack --mode production",
    "prod:adminCSS": "sass --no-source-map --style=compressed app/assets/stylesheets/application.scss:public/assets/css/main.css",
    "prod:landingCSS": "sass --no-source-map --style=compressed app/assets/stylesheets/landing.scss:public/assets/css/landing.css"
  },
  "dependencies": {
    "html5sortable": "^0.9.3",
    "moment-es6": "^1.0.0",
    "prop-types": "^15.6.1",
    "raw-loader": "^0.5.1",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-reorder": "^3.0.0-alpha.6",
    "react-svg": "^16.3.0",
    "react-transition-group": "^2.9.0",
    "sass": "^1.49.9"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-react": "^7.28.5",
    "babel-loader": "^8.4.1",
    "watch": "^0.17.1",
    "webpack": "^5.103.0",
    "webpack-cli": "^4.10.0"
  }
}
